# === APPLICATION ===
APP_ENV=dev
DOMAIN=localhost
# DOMAIN=mediaplan.youragency.ru   # uncomment for production
MOCK_YANDEX=true
LOG_LEVEL=INFO

# === DATABASE ===
DATABASE_PATH=data/tasks.db

# === REDIS ===
REDIS_URL=redis://redis:6379/0

# === CONCURRENCY ===
CONCURRENCY=3
ARQ_MAX_JOBS=10
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=10

# === WORDSTAT SEARCH API ===
WORDSTAT_API_KEY=
WORDSTAT_FOLDER_ID=
WORDSTAT_MIN_FREQ=30
MAX_KEYWORDS=200

# === YANDEX DIRECT (browser automation) ===
DIRECT_FORECAST_URL=https://direct.yandex.ru/registered/main.pl?cmd=advancedForecast
DIRECT_STORAGE_STATE=data/storage_state.json
DIRECT_BATCH_SIZE=100
DIRECT_TIMEOUT_MS=45000
YANDEX_DIRECT_LOGIN=
YANDEX_DIRECT_PASSWORD=
PLAYWRIGHT_HEADLESS=true

# === YANDEX GPT (AI analytics) ===
YANDEX_GPT_BASE_URL=https://llm.api.cloud.yandex.net/v1
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL=
YANDEX_GPT_TEMPERATURE=0.3
YANDEX_GPT_TIMEOUT_S=60

# === ADMIN ===
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-at-least-32-random-chars
SESSION_TTL_SECONDS=86400
LOGIN_RATE_LIMIT=5
PUBLIC_RATE_LIMIT=10

# === PDF ===
PDF_TOKEN_TTL_SECONDS=604800
PDF_OUTPUT_DIR=data/pdf
UPLOAD_MAX_BYTES=5242880

# === PROGRESS ===
PROGRESS_TTL_SECONDS=3600
KPI_MEDIAN_SECONDS=180
